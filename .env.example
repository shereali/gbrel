# Docker Compose production secrets for GBREL
APP_NAME=GBREL
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:/mT/iIzQ1xKz5SLCl0fzUeEEoAdeyyRI2EgoIK+UbYg=
APP_URL=https://gbrel.com

DB_CONNECTION=mysql
DB_HOST=gbrel-db
DB_PORT=3306
DB_DATABASE=gbrel
DB_USERNAME=gbrel_user
DB_PASSWORD=gbrel_secret_pass_2026
DB_ROOT_PASSWORD=gbrel_secret_pass_2026

ADMIN_EMAIL=admin@gbrel.com
ADMIN_PASSWORD=admin123

MAIL_MAILER=log
MAIL_FROM_ADDRESS=contact@gbrel.com
MAIL_FROM_NAME=GBREL

# Meta Conversions API: server-side copy of Lead events. Leave the token empty to switch it off.
META_PIXEL_ID=1390835626467163
META_CAPI_TOKEN=

# Meta Lead Ads → CRM webhook (https://gbrel.com/api/meta/leadgen). App Secret: Meta App → Settings → Basic.
# Verify token: any long random string, typed again in the Meta App webhook settings.
# Page access token: long-lived Page token with leads_retrieval + pages_manage_metadata.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# EasyPay: merchant API key for selling the e-book on /book (Merchant Dashboard → API Settings).
EASYPAY_API_KEY=
BOOK_PRICE=500
